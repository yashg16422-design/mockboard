# Copy to .env and fill in. Never commit .env. All values below are fake or defaults.

# --- Gnani (Prisma STT + Timbre TTS) ---
GNANI_API_KEY=replace-me-with-your-gnani-key
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_SSE_URL=https://api.vachana.ai/api/v1/tts/sse
STT_LANG_CODE=en-IN
STT_SAMPLE_RATE=16000
STT_FORMAT=verbatim
STT_MAX_SPEECH_S=15
# Ruling 27: prisma-v2.5 (default, the contest's model) or prisma-v3.0 (A/B only; try it with
# STT_LANG_CODE=hi-IN,en-IN and STT_FORMAT=codemix).
STT_MODEL=prisma-v2.5
# Prisma's own VAD headers. UNVERIFIED: Gnani's documented defaults until probes P2/P3.
STT_VAD_THRESHOLD=0.7
STT_MIN_SILENCE_MS=500
STT_MIN_SPEECH_MS=100
STT_MIN_SEGMENT_MS=120
# Seconds without detected speech before Prisma closes the session (docs: default 60, 5-900).
STT_IDLE_TIMEOUT_S=300
# keyterms/topic per interview topic or motion (Prisma v3.0 only).
STT_CONTEXT_ENABLED=true
# v2.5 single-word boosting: 0 keeps it off (probe rule P6).
STT_BIAS_SCORE=0.0
# Ruling 28/31: bounded waits for the transcripts a `commit` closes. UNVERIFIED.
STT_COMMIT_WAIT_MS=1500
STT_COMMIT_NOOP_MS=300
TTS_MODEL=timbre-v2.5
# Ruling 25: gnani-vachana 0.7.9 refuses hi-en; "auto" is Gnani's value for mixed text
# (tts-websocket.md). Also accepted: hi-IN, en-IN and the other <lang>-IN codes.
TTS_LANGUAGE=auto
TTS_SAMPLE_RATE=16000
TTS_VOICE=Poorvi
# Ruling 30: Timbre first-byte watchdog and one-request-at-a-time bound. UNVERIFIED.
TTS_FIRST_BYTE_TIMEOUT_S=3.0
TTS_REQUEST_TIMEOUT_S=20.0

# --- Voice loop turn-taking (python -m mockboard.voice.server). All UNVERIFIED on Hinglish ---
VOICE_VAD_START_SECS=0.2
VOICE_VAD_STOP_SECS=0.2
VOICE_SMART_TURN_STOP_SECS=3.0
VOICE_USER_TURN_STOP_TIMEOUT_S=5.0
VOICE_LONG_TURN_EXTRA_PAUSE_S=1.2
VOICE_LONG_TURN_SMART_TURN_STOP_SECS=5.0
VOICE_LONG_TURN_STOP_TIMEOUT_S=8.0
VOICE_BARGE_IN_MIN_SPEECH_MS=500
VOICE_RESUME_MIN_SPEECH_MS=150
VOICE_SESSION_MAX_S=600

# --- AWS Bedrock (credentials come from the default chain: `aws configure` profile or EC2 role) ---
AWS_REGION=ap-southeast-2
NOVA_MODEL_ID=amazon.nova-pro-v1:0
# AWS_PROFILE=default

# --- Brain tuning ---
NUMERIC_REL_TOLERANCE=0.05
NUMERIC_ABS_TOLERANCE_PP=1.0
# Must be >= 1 (validated): fact checks run in the background (ruling 9).
FACT_CHALLENGE_MIN_DELAY_TURNS=1
# UNVERIFIED placeholder for the voice path; set it from probe data.
MOVE_DEADLINE_MS=1500
TEXT_MOVE_DEADLINE_S=30
# UNVERIFIED placeholder (ruling 14): actor's wait for its first token before the fallback line.
ACTOR_FIRST_TOKEN_BUDGET_S=2.5
# Ruling 17: retry the actor once only if Bedrock throttles it within this many ms. Off until
# the Nova probe's throttle timings say it helps.
ACTOR_FAST_THROTTLE_RETRY=false
ACTOR_FAST_THROTTLE_WINDOW_MS=300
FACT_CHECK_DRAIN_TIMEOUT_S=30
MAX_TURNS_PER_TOPIC=4
CACHE_PREFIX_TOKEN_BUDGET=18000
REPORT_LANGUAGE=en

# --- Eval gate (`make eval-gate`); our own thresholds, the recall floor is a placeholder ---
EVAL_GATE_MIN_PLANTED_RECALL=0.8
EVAL_GATE_MAX_FALSE_CORRECTIONS=0

# --- Feature flags (all default to the safe setting: off) ---
FEATURE_DUAL_DECODE=false
FEATURE_BOARD_INTERRUPT=false
FEATURE_ECHO_FILTER=false
FEATURE_PRISMA_PARTIALS=false
FEATURE_SECOND_PROMPT_VOTE=false

# --- Observability ---
TRACE_DIR=traces
LANGFUSE_ENABLED=false
